<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Plain" name="Plain" />
    <bpmn:startEvent id="StartEvent_Listener" name="With listener">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="order-started" retries="3" />
        </zenbpm:executionListeners>
        <zenbpm:ioMapping>
          <zenbpm:output source="=orderId" target="orderId" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_OnlyListener" name="Only a listener">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="order-started" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_1">
      <bpmn:startEvent id="StartEvent_SubProcess" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_1" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_EventSubProcess">
        <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
      </bpmn:startEvent>
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask_1" />
    <bpmn:endEvent id="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_Plain_di" bpmnElement="StartEvent_Plain">
        <dc:Bounds x="100" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Listener_di" bpmnElement="StartEvent_Listener">
        <dc:Bounds x="200" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_OnlyListener_di" bpmnElement="StartEvent_OnlyListener">
        <dc:Bounds x="300" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_1_di" bpmnElement="SubProcess_1" isExpanded="true">
        <dc:Bounds x="100" y="200" width="200" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_SubProcess_di" bpmnElement="StartEvent_SubProcess">
        <dc:Bounds x="140" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EventSubProcess_1_di" bpmnElement="EventSubProcess_1" isExpanded="true">
        <dc:Bounds x="350" y="200" width="200" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_EventSubProcess_di" bpmnElement="StartEvent_EventSubProcess">
        <dc:Bounds x="390" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="ServiceTask_1">
        <dc:Bounds x="400" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="550" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
