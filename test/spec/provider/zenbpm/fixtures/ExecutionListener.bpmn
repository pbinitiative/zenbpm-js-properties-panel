<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <zenbpm:executionListeners>
        <zenbpm:executionListener eventType="end" type="process-ended" />
      </zenbpm:executionListeners>
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_Plain" name="Plain">
      <bpmn:outgoing>Flow_StartEvent_Plain</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_Plain" sourceRef="StartEvent_Plain" targetRef="EndEvent_1" />
    <bpmn:startEvent id="StartEvent_Listener" name="With listener">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="order-started" retries="3" />
        </zenbpm:executionListeners>
        <zenbpm:ioMapping>
          <zenbpm:output source="=orderId" target="orderId" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartEvent_Listener</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_Listener" sourceRef="StartEvent_Listener" targetRef="EndEvent_1" />
    <bpmn:startEvent id="StartEvent_OnlyListener" name="Only a listener">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="order-started" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartEvent_OnlyListener</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_OnlyListener" sourceRef="StartEvent_OnlyListener" targetRef="EndEvent_1" />
    <bpmn:startEvent id="StartEvent_Backoff" name="Listener with a backoff">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="order-started" retries="5" retryBackoff="PT10S" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartEvent_Backoff</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_Backoff" sourceRef="StartEvent_Backoff" targetRef="EndEvent_1" />
    <bpmn:startEvent id="StartEvent_StartListener" name="Start listener, which a start event does not take">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartEvent_StartListener</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_StartListener" sourceRef="StartEvent_StartListener" targetRef="EndEvent_1" />
    <bpmn:startEvent id="StartEvent_TwoListeners" name="Two listeners">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="first" />
          <zenbpm:executionListener eventType="end" type="second" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartEvent_TwoListeners</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_TwoListeners" sourceRef="StartEvent_TwoListeners" targetRef="EndEvent_1" />
    <bpmn:intermediateThrowEvent id="ThrowEvent_Message" name="Throws a message">
      <bpmn:outgoing>Flow_ThrowEvent_Message</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_ThrowEvent_Message" sourceRef="ThrowEvent_Message" targetRef="EndEvent_1" />
    <bpmn:intermediateThrowEvent id="ThrowEvent_None" name="Throws nothing">
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_1" name="Gateway">
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_1" name="Plain">
      <bpmn:outgoing>Flow_ServiceTask_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_1" sourceRef="ServiceTask_1" targetRef="EndEvent_1" />
    <bpmn:sendTask id="SendTask_1" name="Send">
      <bpmn:outgoing>Flow_SendTask_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_SendTask_1" sourceRef="SendTask_1" targetRef="EndEvent_1" />
    <bpmn:userTask id="UserTask_1" name="User">
      <bpmn:outgoing>Flow_UserTask_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_UserTask_1" sourceRef="UserTask_1" targetRef="EndEvent_1" />
    <bpmn:businessRuleTask id="BusinessRuleTask_JobWorker" name="Rules by a job worker">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="rules" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BusinessRuleTask_JobWorker</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_BusinessRuleTask_JobWorker" sourceRef="BusinessRuleTask_JobWorker" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_StandardLoop" name="Standard loop">
      <bpmn:outgoing>Flow_ServiceTask_StandardLoop</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_StandardLoop" sourceRef="ServiceTask_StandardLoop" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_Chain" name="Chain">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="reserve-stock" />
          <zenbpm:executionListener eventType="end" type="notify-customer" />
          <zenbpm:executionListener eventType="start" type="check-credit" />
          <zenbpm:executionListener eventType="end" type="archive-order" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_Chain</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_Chain" sourceRef="ServiceTask_Chain" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_Duplicate" name="Same type twice">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
          <zenbpm:executionListener eventType="end" type="audit" />
          <zenbpm:executionListener eventType="start" type=" audit " />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_Duplicate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_Duplicate" sourceRef="ServiceTask_Duplicate" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_NoOutgoing" name="No outgoing flow">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_MultiInstance" name="Multi-instance with a listener">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_MultiInstance</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_MultiInstance" sourceRef="ServiceTask_MultiInstance" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_MultiInstancePlain" name="Multi-instance">
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_UnknownEventType" name="Event type of another spelling">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="End" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_UnknownEventType</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_UnknownEventType" sourceRef="ServiceTask_UnknownEventType" targetRef="EndEvent_1" />
    <bpmn:businessRuleTask id="BusinessRuleTask_Dmn" name="Rules by a decision">
      <bpmn:extensionElements>
        <zenbpm:calledDecision decisionId="decide" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_DmnListener" name="Rules by a decision, with a listener">
      <bpmn:extensionElements>
        <zenbpm:calledDecision decisionId="decide" />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BusinessRuleTask_DmnListener</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_BusinessRuleTask_DmnListener" sourceRef="BusinessRuleTask_DmnListener" targetRef="EndEvent_1" />
    <bpmn:scriptTask id="ScriptTask_1" name="Script">
    </bpmn:scriptTask>
    <bpmn:receiveTask id="ReceiveTask_1" name="Receive">
    </bpmn:receiveTask>
    <bpmn:callActivity id="CallActivity_1" name="Call">
    </bpmn:callActivity>
    <bpmn:serviceTask id="ServiceTask_TwoContainers" name="Two listener elements">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="visible" />
        </zenbpm:executionListeners>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="hidden" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_TwoContainers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_TwoContainers" sourceRef="ServiceTask_TwoContainers" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_EmptyFirstContainer" name="An empty listener element first">
      <bpmn:extensionElements>
        <zenbpm:executionListeners />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="later" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_EmptyFirstContainer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_EmptyFirstContainer" sourceRef="ServiceTask_EmptyFirstContainer" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_EmptyAttributes" name="Empty attributes">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="" retries="" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_EmptyAttributes</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_EmptyAttributes" sourceRef="ServiceTask_EmptyAttributes" targetRef="EndEvent_1" />
    <bpmn:businessRuleTask id="BusinessRuleTask_NoType" name="Rules by a job worker without a type">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BusinessRuleTask_NoType</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_BusinessRuleTask_NoType" sourceRef="BusinessRuleTask_NoType" targetRef="EndEvent_1" />
    <bpmn:businessRuleTask id="BusinessRuleTask_DecisionAndJobWorker" name="Rules by a decision and a job worker">
      <bpmn:extensionElements>
        <zenbpm:calledDecision decisionId="decide" />
        <zenbpm:taskDefinition type="rules" />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BusinessRuleTask_DecisionAndJobWorker</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_BusinessRuleTask_DecisionAndJobWorker" sourceRef="BusinessRuleTask_DecisionAndJobWorker" targetRef="EndEvent_1" />
    <bpmn:businessRuleTask id="BusinessRuleTask_UnnamedDecision" name="Rules by a job worker, beside a decision without an id">
      <bpmn:extensionElements>
        <zenbpm:calledDecision decisionId="" />
        <zenbpm:taskDefinition type="rules" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BusinessRuleTask_UnnamedDecision</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_BusinessRuleTask_UnnamedDecision" sourceRef="BusinessRuleTask_UnnamedDecision" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="ServiceTask_BackoffExpression" name="Backoff the engine refuses">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="audit" retryBackoff="=backoff" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceTask_BackoffExpression</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ServiceTask_BackoffExpression" sourceRef="ServiceTask_BackoffExpression" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_StartEvent_Plain</bpmn:incoming>
      <bpmn:incoming>Flow_StartEvent_Listener</bpmn:incoming>
      <bpmn:incoming>Flow_StartEvent_OnlyListener</bpmn:incoming>
      <bpmn:incoming>Flow_StartEvent_Backoff</bpmn:incoming>
      <bpmn:incoming>Flow_StartEvent_StartListener</bpmn:incoming>
      <bpmn:incoming>Flow_StartEvent_TwoListeners</bpmn:incoming>
      <bpmn:incoming>Flow_ThrowEvent_Message</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_1</bpmn:incoming>
      <bpmn:incoming>Flow_SendTask_1</bpmn:incoming>
      <bpmn:incoming>Flow_UserTask_1</bpmn:incoming>
      <bpmn:incoming>Flow_BusinessRuleTask_JobWorker</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_StandardLoop</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_Chain</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_Duplicate</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_MultiInstance</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_UnknownEventType</bpmn:incoming>
      <bpmn:incoming>Flow_BusinessRuleTask_DmnListener</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_TwoContainers</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_EmptyFirstContainer</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_EmptyAttributes</bpmn:incoming>
      <bpmn:incoming>Flow_BusinessRuleTask_NoType</bpmn:incoming>
      <bpmn:incoming>Flow_BusinessRuleTask_DecisionAndJobWorker</bpmn:incoming>
      <bpmn:incoming>Flow_BusinessRuleTask_UnnamedDecision</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceTask_BackoffExpression</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_1" name="Sub-process">
      <bpmn:startEvent id="StartEvent_SubProcess" name="Start of the sub-process" />
      <bpmn:startEvent id="StartEvent_SubProcessListener" name="Start of the sub-process, with a listener">
        <bpmn:extensionElements>
          <zenbpm:executionListeners>
            <zenbpm:executionListener eventType="end" type="nested" />
          </zenbpm:executionListeners>
        </bpmn:extensionElements>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask_InSubProcess" name="Inside the sub-process">
        <bpmn:outgoing>Flow_ServiceTask_InSubProcess</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_SubProcess" name="End of the sub-process">
        <bpmn:incoming>Flow_ServiceTask_InSubProcess</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ServiceTask_InSubProcess" sourceRef="ServiceTask_InSubProcess" targetRef="EndEvent_SubProcess" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_1" name="Event sub-process" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_EventSubProcess" name="Timer of the event sub-process">
        <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
      </bpmn:startEvent>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
